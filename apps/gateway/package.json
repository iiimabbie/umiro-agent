{
  "name": "@umiro/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "dependencies": {
    "@umiro/adapter-discord": "workspace:*",
    "@umiro/core": "workspace:*",
    "@umiro/model-openai": "workspace:*",
    "@umiro/storage-sqlite": "workspace:*",
    "croner": "^9.1.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm build && node --test dist/test/*.test.js",
    "start": "node dist/src/main.js"
  }
}
