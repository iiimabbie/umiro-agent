{
  "schemaVersion": 0,
  "id": "context-files",
  "version": "0.0.0",
  "coreApi": "0",
  "entry": "./dist/src/index.js",
  "permissions": {
    "capabilities": ["context.files.read", "owner.profile.write"],
    "visibility": { "kind": "all" },
    "instructionAuthority": "full"
  },
  "namespace": "context-files",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["workspacePath"],
    "properties": {
      "workspacePath": { "type": "string", "minLength": 1 },
      "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
    }
  },
  "contributes": {
    "contextProviders": ["context.bootstrap", "context.soul", "context.agent", "context.owner", "context.memory", "context.skills", "context.conversation_history"],
    "tools": ["owner_profile_add", "owner_profile_replace"]
  }
}
